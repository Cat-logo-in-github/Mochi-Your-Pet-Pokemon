{
  "name": "mochi",
  "version": "1.3.0",
  "private": true,
  "type": "module",
  "packageManager": "npm@11.6.2",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "dev": "npm run dev --workspace @mochi/web",
    "build": "npm run build --workspace @mochi/extension && npm run build --workspace @mochi/web",
    "test": "vitest run",
    "lint": "eslint . && prettier --check .",
    "format": "prettier --write .",
    "typecheck": "tsc --noEmit",
    "package": "node scripts/package-release.mjs",
    "verify:release": "node scripts/verify-release.mjs",
    "validate:manifest": "node scripts/validate-manifest.mjs",
    "check": "npm run validate:assets && npm run typecheck && npm test && npm run lint && npm run build && npm run package && npm run verify:release",
    "validate:assets": "node scripts/validate-pet-assets.mjs",
    "package:project": "node scripts/package-project.mjs",
    "verify:project": "node scripts/verify-project.mjs"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@testing-library/dom": "10.4.2",
    "@testing-library/react": "16.3.3",
    "@types/chrome": "0.3.6",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "eslint": "10.13.0",
    "fflate": "0.8.3",
    "jsdom": "29.1.1",
    "prettier": "3.9.10",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.0",
    "vite": "8.3.5",
    "vitest": "5.0.5"
  },
  "workspaces": [
    "apps/extension",
    "apps/web",
    "packages/*"
  ]
}
