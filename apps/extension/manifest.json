{
  "manifest_version": 3,
  "name": "Mochi - your little browser companion",
  "version": "1.3.0",
  "description": "A local-first sprite companion with system reminders, Calendar events and browser playback controls.",
  "minimum_chrome_version": "120",
  "permissions": ["storage", "alarms", "notifications", "identity", "activeTab"],
  "optional_host_permissions": ["https://www.googleapis.com/*", "https://gmail.googleapis.com/*"],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Mochi"
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "content_scripts": [
    {
      "matches": ["http://*/*", "https://*/*"],
      "js": ["content.js"],
      "run_at": "document_idle",
      "all_frames": false
    },
    {
      "matches": ["http://*/*", "https://*/*"],
      "js": ["media-bridge.js"],
      "run_at": "document_idle",
      "all_frames": true
    }
  ],
  "commands": {
    "toggle-mochi": {
      "suggested_key": {
        "default": "Alt+Shift+M"
      },
      "description": "Hide or show Mochi"
    },
    "shutdown-mochi": {
      "suggested_key": {
        "default": "Alt+Shift+Q"
      },
      "description": "Shut down Mochi services"
    },
    "summon-mochi": {
      "suggested_key": {
        "default": "Alt+Shift+C"
      },
      "description": "Call Mochi to the current web page"
    }
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'"
  },
  "web_accessible_resources": [
    {
      "resources": [
        "audio/cloud-garden.wav",
        "audio/little-afternoon.wav",
        "mochi/manifest.json",
        "mochi/atlases/*.png",
        "mochi/posters/*.png"
      ],
      "matches": ["http://*/*", "https://*/*"]
    }
  ]
}
