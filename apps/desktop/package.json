{
  "name": "@mochi/desktop-scaffold",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "OPTIONAL UNCOMPILED Tauri desktop scaffold; excluded from Mochi core builds",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "tauri dev",
    "build": "tauri build",
    "web:dev": "vite --host 127.0.0.1 --port 1420 --strictPort",
    "web:build": "tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@tauri-apps/api": "2.12.4",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@tauri-apps/cli": "2.12.4",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "typescript": "6.0.3",
    "vite": "8.3.5"
  }
}
